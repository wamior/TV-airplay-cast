{
  "name": "tv-airplay-cast-desktop",
  "version": "0.2.0",
  "description": "Receive AirPlay mirroring and DLNA casts from your phone on a PC",
  "main": "main.js",
  "license": "GPL-3.0-or-later",
  "author": "wamior",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win zip --publish never"
  },
  "dependencies": {
    "bonjour-service": "1.3.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.wamior.tvcast.desktop",
    "productName": "TV AirPlay Cast",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "core/build/airplay-core.exe",
        "to": "airplay-core.exe"
      }
    ],
    "win": {
      "target": "zip"
    },
    "artifactName": "tv-airplay-desktop.${ext}"
  }
}
